# The local stack's settings (read by stack.ps1 and scripts/*.sh through COMPOSE_ENV_FILES).
# Development values for one machine; nothing here is used in staging or production, which run
# in Kubernetes (likho-deploy). To change a value on your machine, put it in .env.development.local.

GATEWAY_PORT=8080        # 80 is taken by IIS on the development machine
POSTGRES_PORT=5433       # 5432 is taken by a local PostgreSQL
REDIS_PORT=6380          # 6379 is taken by a local Redis
MONGO_PORT=27017
NATS_PORT=4222
NATS_MONITOR_PORT=8222
S3_PORT=9000
MEILI_PORT=7700
GRAFANA_PORT=3000

POSTGRES_PASSWORD=likho-dev
MEILI_MASTER_KEY=likho-dev-master-key
