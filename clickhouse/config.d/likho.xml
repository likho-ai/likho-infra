<!-- ClickHouse on a developer's machine: one small server, held to about a gigabyte, quiet logs.
     Mounted as one file into /etc/clickhouse-server/config.d/, beside the image's own files
     (which make the server listen on every interface). -->
<clickhouse>
  <max_server_memory_usage>900000000</max_server_memory_usage>
  <max_server_memory_usage_to_ram_ratio>0</max_server_memory_usage_to_ram_ratio>
  <mark_cache_size>134217728</mark_cache_size>
  <uncompressed_cache_size>67108864</uncompressed_cache_size>
  <max_concurrent_queries>50</max_concurrent_queries>
  <logger>
    <level>warning</level>
  </logger>
  <query_log remove="1" />
  <query_thread_log remove="1" />
  <metric_log remove="1" />
  <asynchronous_metric_log remove="1" />
  <trace_log remove="1" />
  <part_log remove="1" />
  <text_log remove="1" />
  <session_log remove="1" />
  <processors_profile_log remove="1" />
</clickhouse>
