# Copy to .env to change a port or a local password. Every value has a default in compose.yaml.
# These are development values for one machine. Nothing here is used in a real environment.

GATEWAY_PORT=8080        # 80 is taken by IIS on the development machine
POSTGRES_PORT=5433       # 5432 is taken by a local PostgreSQL
REDIS_PORT=6380          # 6379 is taken by a local Redis
MONGO_PORT=27017
NATS_PORT=4222
NATS_MONITOR_PORT=8222
S3_PORT=9000
MEILI_PORT=7700
GRAFANA_PORT=3000

POSTGRES_PASSWORD=likho-dev
MEILI_MASTER_KEY=likho-dev-master-key
